{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(curl:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(whoami)",
      "Bash(echo:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm publish:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Ready for new instructions\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/session-start.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/suggest-compact.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/quality-gate.js\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/session-end.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/evaluate-session.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/cost-tracker.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "api-scaffolding@claude-code-workflows": true,
    "application-performance@claude-code-workflows": true,
    "backend-development@claude-code-workflows": true,
    "cicd-automation@claude-code-workflows": true,
    "cloud-infrastructure@claude-code-workflows": true,
    "code-documentation@claude-code-workflows": true,
    "code-refactoring@claude-code-workflows": true,
    "code-review-ai@claude-code-workflows": true,
    "codebase-cleanup@claude-code-workflows": true,
    "comprehensive-review@claude-code-workflows": true,
    "context-management@claude-code-workflows": true,
    "database-design@claude-code-workflows": true,
    "database-migrations@claude-code-workflows": true,
    "deployment-validation@claude-code-workflows": true,
    "developer-essentials@claude-code-workflows": true,
    "documentation-generation@claude-code-workflows": true,
    "error-debugging@claude-code-workflows": true,
    "kubernetes-operations@claude-code-workflows": true,
    "observability-monitoring@claude-code-workflows": true,
    "performance-testing-review@claude-code-workflows": true,
    "python-development@claude-code-workflows": true,
    "quantitative-trading@claude-code-workflows": true,
    "ui-design@claude-code-workflows": true,
    "Notion@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "conductor@claude-code-workflows": true,
    "supabase@claude-plugins-official": true,
    "debugging-toolkit@claude-code-workflows": true,
    "dependency-management@claude-code-workflows": true,
    "deployment-strategies@claude-code-workflows": true,
    "error-diagnostics@claude-code-workflows": true,
    "frontend-mobile-development@claude-code-workflows": true,
    "security-compliance@claude-code-workflows": true,
    "security-scanning@claude-code-workflows": true,
    "elements-of-style@superpowers-marketplace": true,
    "episodic-memory@superpowers-marketplace": true,
    "superpowers@superpowers-marketplace": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "sentry@claude-plugins-official": true,
    "marketing-skills@marketingskills": true,
    "interface-design@interface-design": true,
    "typescript-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
