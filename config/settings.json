{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(curl:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(whoami)",
      "Bash(echo:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm publish:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Ready for new instructions\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/session-start.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/suggest-compact.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/pre-push-reminder.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/quality-gate.js\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/session-end.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/evaluate-session.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/hooks/cost-tracker.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "api-scaffolding@claude-code-workflows": false,
    "application-performance@claude-code-workflows": false,
    "backend-development@claude-code-workflows": true,
    "cicd-automation@claude-code-workflows": false,
    "cloud-infrastructure@claude-code-workflows": false,
    "code-documentation@claude-code-workflows": false,
    "code-refactoring@claude-code-workflows": false,
    "code-review-ai@claude-code-workflows": false,
    "codebase-cleanup@claude-code-workflows": false,
    "comprehensive-review@claude-code-workflows": true,
    "context-management@claude-code-workflows": false,
    "database-design@claude-code-workflows": false,
    "database-migrations@claude-code-workflows": false,
    "deployment-validation@claude-code-workflows": false,
    "developer-essentials@claude-code-workflows": false,
    "documentation-generation@claude-code-workflows": false,
    "error-debugging@claude-code-workflows": false,
    "kubernetes-operations@claude-code-workflows": false,
    "observability-monitoring@claude-code-workflows": false,
    "performance-testing-review@claude-code-workflows": false,
    "python-development@claude-code-workflows": false,
    "quantitative-trading@claude-code-workflows": false,
    "ui-design@claude-code-workflows": true,
    "vercel@claude-plugins-official": true,
    "conductor@claude-code-workflows": false,
    "supabase@claude-plugins-official": true,
    "debugging-toolkit@claude-code-workflows": false,
    "dependency-management@claude-code-workflows": false,
    "deployment-strategies@claude-code-workflows": false,
    "error-diagnostics@claude-code-workflows": false,
    "frontend-mobile-development@claude-code-workflows": false,
    "security-compliance@claude-code-workflows": false,
    "security-scanning@claude-code-workflows": false,
    "double-shot-latte@superpowers-marketplace": false,
    "elements-of-style@superpowers-marketplace": false,
    "episodic-memory@superpowers-marketplace": true,
    "superpowers@superpowers-marketplace": false,
    "superpowers-developing-for-claude-code@superpowers-marketplace": false,
    "sentry@claude-plugins-official": false,
    "marketing-skills@marketingskills": false,
    "interface-design@interface-design": false,
    "typescript-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "notion@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "pstack@pstack-claude": true
  },
  "alwaysThinkingEnabled": true,
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_PROMPT_CACHE_TTL_MINUTES": "60"
  },
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 400000,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skillOverrides": {
    "ios-clean": "off",
    "ios-design-review": "off",
    "ios-fix": "off",
    "ios-qa": "off",
    "ios-sync": "off",
    "cso": "off",
    "design-shotgun": "off",
    "document-generate": "off",
    "landing-report": "off",
    "benchmark-models": "off",
    "connect-chrome": "off",
    "open-gstack-browser": "off",
    "agentation-self-driving": "off",
    "animation-vocabulary": "off",
    "ask-matt": "off",
    "resolving-merge-conflicts": "off",
    "plankton-code-quality": "off"
  }
}
